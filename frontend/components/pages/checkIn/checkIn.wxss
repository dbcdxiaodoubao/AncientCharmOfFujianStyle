.container {
    padding: 20rpx;
    background-color: #f5f5f5;
}

/* 标签切换 */
.tab-switch {
    display: flex;
    margin-bottom: 20rpx;
    border-radius: 10rpx;
    overflow: hidden;
    border: 1px solid #eee;
}

.tab-btn {
    flex: 1;
    height: 60rpx;
    line-height: 40rpx;
    background-color: #fff;
    border: none;
    border-right: 1px solid #eee;
    font-size: 28rpx;
}

.tab-btn:last-child {
    border-right: none;
}

.tab-btn.active {
    background-color: #FFA500;
    color: #fff;
    position: relative;
}

/* 激活态底部线条 */
.tab-btn.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 4rpx;
    background-color: #e68a00;
}

/* 搜索框 */
.search-box {
    display: flex;
    gap: 5rpx;
    margin-bottom: 20rpx;
    padding: 0 10rpx;
    border-radius: 30px;
}

.search-input {
    width: 280%;
    height: 80rpx;
    padding: 0 20rpx;
    background-color: #fff;
    border-radius: 30rpx;
    border: 1px solid #eee;
    font-size: 28rpx;
}

.search-btn {
    width: 10px;
    height: 80rpx;
    line-height: 50rpx;
    background-color: #FFA500;
    color: #fff;
    border-radius: 30rpx;
    border: none;
    font-size: 28rpx;
}

/* 分页 */
.pagination {
    width: 95%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx;
    background-color: #fff;
    margin-bottom: 20rpx;
    border-radius: 10rpx;
    border: 1px solid #eee;
    font-size: 30rpx;
}

.count {
    display: flex;
    gap: 30rpx;
    margin-top: 20rpx;
}

.page {
    display: flex;
    gap: 10rpx;
}

.flex-count{
    display: flex;
}

.page-size-input {
    width: 50rpx;
    height: 40rpx;
    text-align: center;
    border-radius: 6rpx;
}

.pagination button {
    width: 300rpx;
    padding: 10rpx 20rpx;
    border: 1px solid #eee;
    border-radius: 20rpx;
    background-color: #fff;
}

.pagination button:disabled {
    color: #999;
    background-color: #f8f8f8;
}

/* 列表容器 */
.list-container {
    background-color: #fff;
    border-radius: 10rpx;
    padding: 0;
    border: 1px solid #eee;
    width: 100%;
}

/* 列表标题栏（新增） */
.list-header {
    display: flex;
    padding: 20rpx;
    border-bottom: 2rpx solid #f0f0f0;
    background-color: #fafafa;
    width: 100%;
}

.list-header-item {
    flex: 1;
    font-weight: bold;
    font-size: 28rpx;
    color: #333;
}

/* 列表项 */
.list-item {
    padding: 20rpx;
    border-bottom: 1px solid #f0f0f0;
}

.list-item:last-child {
    border-bottom: none;
}

.list-item:active {
    background-color: #f8f8f8;
}

.item-row {
    display: flex;
    margin-bottom: 15rpx;
    position: relative;
    margin: 10rpx 0;
}

/* 每行左侧竖线（新增） */
.item-row::before {
    content: '';
    position: absolute;
    left: -10rpx;
    top: 16rpx;
    width: 8rpx;
    height: 8rpx;
    background-color: #FFA500;
    border-radius: 50%;
}

.label {
    font-weight: bold;
    width: 120rpx;
    display: inline-block;
    color: #333;
    font-size: 28rpx;
}

.item-row text {
    flex: 1;
    font-size: 28rpx;
    color: #666;
    line-height: 1.5;
}

.item-img {
    width: 200rpx;
    height: auto;
    margin-top: 10rpx;
    border-radius: 8rpx;
    border: 1px solid #eee;
    padding: 5rpx;
}

/* 空数据提示 */
.empty-tip {
    text-align: center;
    padding: 60rpx 0;
    color: #999;
    font-size: 28rpx;
    border: 1px dashed #eee;
    margin: 20rpx;
    border-radius: 10rpx;
}