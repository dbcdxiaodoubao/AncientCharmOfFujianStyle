/* 地图容器 */
.map-container {
    width: 100%;
    height: 400rpx;
    margin-bottom: 20rpx;
}

ec-canvas {
    width: 100%;
    height: 100%;
}

/* 筛选栏 */
.filter-panel {
    width: 100%;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 16rpx;
    box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
    padding: 15rpx 10rpx;
    margin-bottom: 20rpx;
    box-sizing: border-box;
}

.tab-nav {
    display: flex;
    justify-content: space-between;
    gap: 10rpx;
    flex-wrap: wrap;
}

.tab-item {
    padding: 10rpx 15rpx;
    font-size: 24rpx;
    color: #666;
    border-radius: 16rpx;
    background: #f9f9f9;
    text-align: center;
    flex: 1;
    min-width: 80rpx;
    white-space: nowrap;
}

.tab-item.active{
    background: #fff;
    color: #FFA500;
    border-color: #FFA500;
    font-weight: bold;
}

/* 内容面板 */
.content-panel {
    width: 100%;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 16rpx;
    padding: 30rpx;
    box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
    box-sizing: border-box;
}

/* 搜索框 */
.search-container {
    width: 100%;
    padding: 20rpx;
    background: #f9f9f9;
    border-radius: 16rpx;
    margin-bottom: 30rpx;
    box-sizing: border-box;
    position: relative;
}

.search-input {
    width: 100%;
    padding: 20rpx;
    font-size: 28rpx;
    color: #333;
    border: none;
    border-radius: 16rpx;
    background: white;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.clear-search {
    position: absolute;
    right: 40rpx;
    top: 50%;
    transform: translateY(-50%);
    font-size: 36rpx;
    color: #999;
    padding: 10rpx;
}

/* 城市筛选提示 */
.city-filter-tip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 10rpx;
    padding: 10rpx 15rpx;
    background: #fff8e1;
    border-radius: 8rpx;
    font-size: 24rpx;
    color: #666;
}

.clear-city {
    color: #ff6b35;
    font-weight: bold;
    padding: 5rpx 10rpx;
}

/* 加载提示 */
.loading-tip {
    text-align: center;
    padding: 40rpx;
    color: #999;
    font-size: 28rpx;
}

/* 列表项 */
.item-card {
    display: flex;
    background: white;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
    border: 1rpx solid #eee;
    align-items: flex-start;
}

.item-card:active {
    background: #f5f5f5;
}

/* 左侧图片 */
.item-image {
    width: 120rpx;
    height: 120rpx;
    border-radius: 8rpx;
    margin-right: 20rpx;
    background: #f9f9f9;
}

/* 右侧内容 */
.item-content {
    flex: 1;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.item-title {
    font-size: 32rpx;
    font-weight: 500;
    color: #333;
    line-height: 1.4;
    word-wrap: break-word;
    margin-bottom: 10rpx;
}

.item-info {
    font-size: 24rpx;
    color: #999;
}

/* 无数据提示 */
.empty-tip {
    text-align: center;
    padding: 60rpx;
    color: #999;
    font-size: 28rpx;
}