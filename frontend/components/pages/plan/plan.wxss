/* 全局容器 - 确保宽度100%，移除多余内边距影响 */
.container {
    width: 100%;
    min-height: 100vh;
    background-color: #f5f5f5;
    padding: 0; /* 移除默认内边距，让子容器完全占宽 */
    box-sizing: border-box;
}

/* 城市选择面板 - 生成路线的容器，宽度100% */
.city-select-panel {
    width: 100%; /* 核心：强制100%宽度 */
    background-color: #fff;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
    box-sizing: border-box; /* 确保padding不影响宽度 */
}

/* 选择项行布局 */
.select-item {
    display: flex;
    align-items: center;
    width: 100%;
    margin-bottom: 25rpx;
    box-sizing: border-box;
}

/* 标签样式 */
.label {
    font-size: 28rpx;
    color: #333;
    width: 120rpx;
    flex-shrink: 0;
    white-space: nowrap;
}

/* 选择器文本框 */
.picker-text {
    flex: 1;
    font-size: 28rpx;
    color: #666;
    padding: 15rpx 20rpx;
    background: #f9f9f9;
    border-radius: 12rpx;
    border: 1px solid #e5e5e5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    box-sizing: border-box;
}

/* 生成路线按钮 - 宽度100% */
.plan-btn {
    width: 100%; /* 核心：按钮宽度100% */
    background: #2973ad;
    color: white;
    border-radius: 12rpx;
    padding: 20rpx;
    font-size: 30rpx;
    margin-top: 10rpx;
    border: none;
    height: 80rpx;
    line-height: 80rpx;
    box-sizing: border-box;
}

.plan-btn.disabled {
    background: #ccc;
}

/* 路线展示区 - 宽度100% */
.route-panel {
    width: 100%; /* 核心：路线容器宽度100% */
    background-color: #fff;
    padding: 30rpx;
    border-radius: 16rpx;
    box-sizing: border-box;
    margin-bottom: 20rpx;
}

/* 加载提示 - 宽度100% */
.loading-tip {
    width: 100%;
    text-align: center;
    padding: 40rpx;
    color: #999;
    font-size: 28rpx;
    background: white;
    border-radius: 20rpx;
    margin-bottom: 20rpx;
    box-sizing: border-box;
}

/* 无数据提示 - 宽度100% */
.empty-tip {
    width: 100%;
    text-align: center;
    padding: 60rpx;
    color: #999;
    font-size: 28rpx;
    background: white;
    border-radius: 20rpx;
    box-sizing: border-box;
}

/* 第X站标题 */
.station-title {
    font-size: 32rpx;
    color: #333;
    font-weight: bold;
    margin-top: 30rpx;
    margin-bottom: 15rpx;
}

/* 信息卡片 - 路线规划卡片宽度100% */
.info-card {
    width: 100%; /* 核心：卡片宽度100% */
    background-color: #f9f9f9;
    border-radius: 20rpx;
    padding: 25rpx;
    margin-bottom: 20rpx;
    border: 1px solid #e5e5e5;
    box-sizing: border-box; /* 确保padding不超出宽度 */
}

/* 信息项 */
.info-item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 15rpx;
    width: 100%;
    box-sizing: border-box;
}

.info-label {
    font-size: 26rpx;
    color: #666;
    width: 140rpx;
}

.info-value {
    font-size: 26rpx;
    color: #333;
    flex: 1;
}

/* 图片宽度100% */
.info-image {
    width: 100%;
    height: 300rpx;
    border-radius: 12rpx;
    margin-top: 10rpx;
    box-sizing: border-box;
}