<view class="detail-container">
    <view class="detail-header">
        <image src="{{'https://122.246.0.213:45333/AncientCharmOfFujianStyle/' + item.pictureUrl}}" class="detail-image" mode="aspectFill" binderror="onImageError" />
        <view class="detail-title-section">
            <text class="detail-title">{{item.name}}</text>
            <text class="detail-category">{{item.cityName}} | {{item.level}}</text>
        </view>
    </view>

    <view class="detail-content">
        <view class="detail-description">
            <rich-text 
                class="description-text" 
                nodes="{{formattedDtl}}"
                wx:if="{{item && item.dtl}}"
            ></rich-text>
            
            <view class="empty-tip" wx:if="{{item && !item.dtl}}">
                <text>暂无详细介绍</text>
            </view>
        </view>
    </view>

    <view class="loading-tip" wx:if="{{isLoading}}">
        <text>加载中...</text>
    </view>

    <view class="error-tip" wx:if="{{!isLoading && !item}}">
        <text>数据加载失败，请重试</text>
    </view>
</view>