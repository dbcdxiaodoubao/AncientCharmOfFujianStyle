.search-container { display:flex; align-items:center; min-height:84rpx; padding:0 24rpx; margin-bottom:24rpx; border:1rpx solid #fff; border-radius:24rpx; background:rgba(255,253,249,.92); box-shadow:inset 3rpx 3rpx 9rpx rgba(139,125,107,.09),inset -3rpx -3rpx 9rpx #fff; }
.search-symbol { position:relative; width:23rpx; height:23rpx; border:3rpx solid #716b60; border-radius:50%; margin-right:22rpx; flex-shrink:0; box-sizing:border-box; }
.search-symbol::after { position:absolute; content:''; width:12rpx; height:3rpx; background:#716b60; right:-10rpx; bottom:-5rpx; transform:rotate(45deg); }
.search-input { flex:1; min-width:0; height:80rpx; border:0; background:transparent; color:var(--ink); font-size:26rpx; }
.search-placeholder { color:#80796d; }
.clear-search { padding:12rpx 0 12rpx 20rpx; font-size:38rpx; line-height:1; color:#716b60; }
.map-card { padding:24rpx 14rpx 16rpx; overflow:hidden; }
.map-heading { padding:0 14rpx; }
.map-heading .section-title { font-size:32rpx; }
.map-container { width:100%; height:444rpx; box-sizing:border-box; }
ec-canvas { width:100%; height:100%; }
.tab-nav { display:flex; justify-content:space-between; gap:8rpx; }
.tab-item { flex:1; min-width:0; min-height:64rpx; padding:0 2rpx; display:flex; align-items:center; justify-content:center; border:1rpx solid var(--line); border-radius:19rpx; box-sizing:border-box; background:#f4f1eb; color:#625e53; font-size:23rpx; white-space:nowrap; }
.tab-item.active { background:var(--olive); border-color:var(--olive); color:#fff; box-shadow:0 4rpx 10rpx rgba(89,102,56,.18); }
.tab-item:active, .item-card:active, .recommendation-card:active { opacity:.82; }
.city-filter-tip { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:18rpx 20rpx; margin-top:20rpx; background:#e3e8db; border-radius:18rpx; font-size:24rpx; color:#4e5a3d; }
.clear-city { flex-shrink:0; padding:6rpx 0; }
.recommendation-section { margin-top:32rpx; }
.section-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-bottom:20rpx; }
.recommendation-toggle { display:flex; align-items:center; justify-content:center; min-height:64rpx; min-width:104rpx; color:#625e53; border:1rpx solid var(--line); border-radius:32rpx; background:rgba(255,253,248,.72); font-size:23rpx; }
.recommendation-toggle-mark { font-size:28rpx; margin-left:10rpx; }
.recommendation-card, .item-card { display:flex; align-items:center; padding:18rpx; margin-bottom:18rpx; box-sizing:border-box; min-width:0; }
.recommendation-image, .item-image { width:136rpx; height:136rpx; margin-right:20rpx; border-radius:20rpx; flex-shrink:0; }
.recommendation-content, .item-content { flex:1; min-width:0; }
.recommendation-topline { display:flex; flex-wrap:wrap; align-items:center; gap:8rpx 12rpx; }
.recommendation-name { color:var(--ink); font-size:28rpx; font-weight:600; line-height:1.5; word-break:break-all; }
.recommendation-score { padding:2rpx 10rpx; border-radius:10rpx; background:#ece5d7; color:#715c3d; font-size:20rpx; white-space:nowrap; }
.recommendation-meta { display:block; margin-top:7rpx; color:#716b60; font-size:22rpx; line-height:1.6; }
.reason-list { margin-top:6rpx; }
.reason-item { display:block; font-size:21rpx; color:#596638; line-height:1.6; }
.reason-item::before { content:'· '; }
.recommendation-loading, .recommendation-empty { padding:28rpx 8rpx; color:#716b60; font-size:25rpx; }
.list-heading { margin-top:34rpx; }
.result-count { font-size:22rpx; color:#716b60; flex-shrink:0; }
.item-title { display:block; font-size:29rpx; font-weight:600; line-height:1.5; word-break:break-all; }
.item-info { display:block; margin-top:10rpx; font-size:23rpx; color:#716b60; }
.item-chevron { color:#8b7d6b; font-size:42rpx; margin-left:12rpx; }
.loading-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:1100; display:flex; align-items:center; justify-content:center; background:rgba(56,60,48,.16); }
.loading-text { padding:24rpx 36rpx; border-radius:24rpx; color:#fff; background:rgba(56,60,48,.88); }
