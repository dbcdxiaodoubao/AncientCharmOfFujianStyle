.feed-page { padding-bottom:190rpx; }
.tag-bar { display:flex; flex-wrap:wrap; gap:12rpx; padding:24rpx; background:rgba(255,253,248,.9); border:1rpx solid #fff; border-radius:26rpx; }
.tag { display:flex; align-items:center; gap:10rpx; padding:12rpx 20rpx; border:1rpx solid var(--line); border-radius:18rpx; background:#f3f0e9; color:#625e53; font-size:24rpx; min-height:60rpx; box-sizing:border-box; }
.tag.active { background:var(--olive); color:#fff; border-color:var(--olive); }
.tag-name { max-width:340rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.tag-count { opacity:.8; font-size:21rpx; }
.tag-more { padding:14rpx; color:var(--olive); font-size:24rpx; }
.feed { margin-top:24rpx; }
.feed-status { padding:68rpx 22rpx; text-align:center; font-size:26rpx; color:var(--muted); line-height:1.8; background:rgba(255,253,248,.65); border-radius:26rpx; }
.moment { display:flex; align-items:flex-start; padding:26rpx 22rpx; margin-bottom:22rpx; background:rgba(255,253,248,.94); border:1rpx solid #fff; border-radius:26rpx; box-shadow:var(--shadow); }
.moment-avatar { width:70rpx; height:70rpx; border-radius:22rpx; flex-shrink:0; display:flex; align-items:center; justify-content:center; color:#fff; font-size:32rpx; font-weight:600; border:3rpx solid #fff; }
.moment-body { flex:1; min-width:0; margin-left:18rpx; }
.moment-name { font-weight:600; color:var(--olive); font-size:28rpx; word-break:break-all; }
.moment-text { margin-top:12rpx; font-size:28rpx; color:var(--ink); line-height:1.8; word-break:break-word; }
.moment-media { margin-top:16rpx; }
.moment-image { width:420rpx; max-width:100%; border-radius:18rpx; background:#e8e5d9; }
.moment-meta { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; margin-top:18rpx; }
.moment-time { font-size:22rpx; color:var(--muted); }
.moment-fy { padding:4rpx 12rpx; color:#596638; background:#e8ecdf; border-radius:10rpx; font-size:21rpx; word-break:break-all; }
.moment-heat { color:#a0522d; font-size:22rpx; }
.moment-actions { display:flex; gap:32rpx; margin-top:18rpx; }
.action { display:flex; gap:8rpx; align-items:center; min-height:56rpx; }
.action-icon { font-size:28rpx; }
.action-count { color:var(--muted); font-size:24rpx; }
.action.active .action-count { color:#a0522d; }
.comment-panel { margin-top:16rpx; padding:18rpx; background:#f0eee5; border-radius:18rpx; }
.comment-item { font-size:25rpx; line-height:1.8; word-break:break-word; margin-bottom:6rpx; }
.comment-user { color:#596638; font-weight:500; }
.comment-content { color:var(--ink); }
.comment-empty, .comment-placeholder { color:#716b60; font-size:23rpx; }
.comment-input-row { display:flex; align-items:center; margin-top:16rpx; border-top:1rpx solid var(--line); padding-top:14rpx; }
.comment-input { flex:1; min-width:0; height:64rpx; font-size:25rpx; }
.comment-send { color:var(--olive); padding:12rpx 0 12rpx 20rpx; font-size:25rpx; }
.pagination { display:flex; align-items:center; justify-content:space-between; gap:14rpx; padding:18rpx 0; }
.page-btn { margin:0; min-width:126rpx; height:70rpx; line-height:70rpx; padding:0 16rpx; font-size:24rpx; border:1rpx solid var(--line); border-radius:20rpx; background:#faf8f2; color:var(--olive); }
.page-info { text-align:center; color:var(--muted); font-size:22rpx; }
.checkin-fab { position:fixed; right:28rpx; bottom:38rpx; bottom:calc(38rpx + env(safe-area-inset-bottom)); z-index:90; display:flex; align-items:center; justify-content:center; gap:10rpx; padding:18rpx 28rpx; border-radius:50rpx; color:#fff; background:#596638; border:2rpx solid #fff; box-shadow:0 8rpx 26rpx rgba(89,102,56,.22); }
.checkin-fab-icon { font-size:34rpx; line-height:1; }
.checkin-fab-text { font-size:26rpx; }
.checkin-fab:active, .action:active, .tag:active { opacity:.8; }
.modal-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:999; background:rgba(56,60,48,.42); }
.check-in-modal { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); width:calc(100% - 40rpx); max-width:690rpx; max-height:86vh; display:flex; flex-direction:column; z-index:1000; border-radius:28rpx; border:1rpx solid #fff; box-sizing:border-box; background:#fbf9f3; overflow:hidden; box-shadow:0 20rpx 60rpx rgba(56,60,48,.2); }
.modal-header { flex-shrink:0; display:flex; align-items:center; justify-content:space-between; padding:22rpx 28rpx; border-bottom:1rpx solid var(--line); }
.modal-title { font-family:'Songti SC','STSong',serif; font-size:34rpx; font-weight:600; }
.modal-close { margin:0; padding:0; width:64rpx; height:64rpx; line-height:64rpx; border-radius:50%; background:#ebe7dd; color:#625e53; font-size:36rpx; }
.modal-body { flex:1; min-height:0; overflow-y:auto; padding:26rpx 28rpx; box-sizing:border-box; }
.form-item { margin-bottom:24rpx; }
.form-item:last-child { margin-bottom:0; }
.form-label { display:block; font-size:26rpx; color:#625e53; margin-bottom:14rpx; }
.form-input, .form-textarea { width:100%; font-size:27rpx; color:var(--ink); padding:18rpx 22rpx; box-sizing:border-box; background:#f1eee5; border:1rpx solid var(--line); border-radius:18rpx; }
.form-input { height:84rpx; }
.form-textarea { height:160rpx; line-height:1.7; }
.fy-selected { display:flex; align-items:center; gap:12rpx; padding:12rpx 18rpx; background:#e5eada; border-radius:14rpx; margin-bottom:12rpx; }
.fy-selected-name { flex:1; min-width:0; color:#536035; font-size:24rpx; word-break:break-all; }
.fy-clear { padding:6rpx; font-size:32rpx; color:#625e53; }
.fy-options { max-height:260rpx; margin-top:12rpx; border:1rpx solid var(--line); border-radius:16rpx; box-sizing:border-box; }
.fy-option { display:flex; align-items:center; gap:16rpx; padding:18rpx; border-bottom:1rpx solid var(--line); font-size:25rpx; }
.fy-option:last-child { border-bottom:0; }
.fy-option.active { background:#e5eada; color:#536035; }
.fy-option-name { flex:1; min-width:0; word-break:break-all; }
.fy-option-city { flex-shrink:0; font-size:22rpx; color:var(--muted); }
.fy-empty { padding:18rpx; text-align:center; color:var(--muted); font-size:24rpx; }
.image-upload { display:flex; flex-wrap:wrap; align-items:center; gap:18rpx; }
.choose-img-btn { margin:0; padding:0 24rpx; min-height:80rpx; line-height:80rpx; border-radius:18rpx; font-size:26rpx; color:#596638; background:#e7ebdd; border:1rpx solid #a6b3a7; }
.preview-img { width:150rpx; height:150rpx; border-radius:18rpx; }
.modal-footer { flex-shrink:0; padding:20rpx 28rpx 28rpx; border-top:1rpx solid var(--line); background:#fbf9f3; }
.submit-check-in-btn { width:100%; height:88rpx; line-height:88rpx; margin:0; padding:0; border-radius:20rpx; color:#fff; background:#596638; font-size:30rpx; }
