page {
    background: #ededed;
}

.feed-page {
    min-height: 100vh;
    padding-bottom: 160rpx;
    box-sizing: border-box;
}

/* 顶部筛选 */
.filter-bar {
    background: #fff;
    padding: 20rpx 24rpx;
    box-sizing: border-box;
    border-bottom: 1rpx solid #e5e5e5;
}

.tab-switch {
    display: flex;
    gap: 8rpx;
    background: #f2f2f2;
    border-radius: 14rpx;
    padding: 6rpx;
}

.tab {
    flex: 1;
    text-align: center;
    height: 64rpx;
    line-height: 64rpx;
    border-radius: 10rpx;
    font-size: 28rpx;
    color: #666;
}

.tab.active {
    background: #9F6B65;
    color: #fff;
    font-weight: bold;
}

.search-box {
    display: flex;
    align-items: center;
    margin-top: 16rpx;
    height: 72rpx;
    padding: 0 24rpx;
    background: #f2f2f2;
    border-radius: 36rpx;
    box-sizing: border-box;
}

.search-icon {
    font-size: 26rpx;
    margin-right: 12rpx;
}

.search-input {
    flex: 1;
    font-size: 28rpx;
    color: #333;
}

.search-placeholder {
    color: #aaa;
}

/* 动态流 */
.feed {
    margin-top: 16rpx;
}

.feed-status {
    text-align: center;
    color: #999;
    font-size: 28rpx;
    padding: 80rpx 0;
}

.moment {
    display: flex;
    align-items: flex-start;
    padding: 26rpx 24rpx;
    background: #fff;
    border-bottom: 1rpx solid #f0f0f0;
}

.moment-avatar {
    width: 84rpx;
    height: 84rpx;
    border-radius: 12rpx;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 40rpx;
    font-weight: bold;
}

.moment-body {
    flex: 1;
    min-width: 0;
    margin-left: 20rpx;
}

.moment-name {
    font-size: 30rpx;
    font-weight: bold;
    color: #576b95;
    margin-bottom: 10rpx;
}

.moment-text {
    font-size: 30rpx;
    color: #222;
    line-height: 1.6;
    word-break: break-word;
}

.moment-media {
    margin-top: 14rpx;
}

.moment-image {
    width: 420rpx;
    border-radius: 10rpx;
    background: #f2f2f2;
}

.moment-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16rpx;
    margin-top: 16rpx;
}

.moment-time {
    font-size: 24rpx;
    color: #999;
}

.moment-fy {
    font-size: 22rpx;
    color: #9F6B65;
    background: #fbf1e8;
    padding: 4rpx 14rpx;
    border-radius: 999rpx;
}

.moment-heat {
    font-size: 22rpx;
    color: #d98a3d;
}

/* 点赞 / 评论 */
.moment-actions {
    display: flex;
    align-items: center;
    gap: 44rpx;
    margin-top: 16rpx;
}

.action {
    display: flex;
    align-items: center;
    gap: 6rpx;
}

.action-icon {
    font-size: 30rpx;
}

.action-count {
    font-size: 24rpx;
    color: #999;
}

.action.active .action-count {
    color: #e1685f;
}

.comment-panel {
    margin-top: 14rpx;
    background: #f7f7f7;
    border-radius: 10rpx;
    padding: 16rpx 18rpx;
}

.comment-item {
    font-size: 26rpx;
    line-height: 1.6;
    word-break: break-word;
}

.comment-user {
    color: #576b95;
}

.comment-content {
    color: #333;
}

.comment-empty {
    font-size: 24rpx;
    color: #aaa;
}

.comment-input-row {
    display: flex;
    align-items: center;
    margin-top: 14rpx;
    border-top: 1rpx solid #ececec;
    padding-top: 14rpx;
}

.comment-input {
    flex: 1;
    font-size: 26rpx;
    color: #333;
}

.comment-placeholder {
    color: #aaa;
}

.comment-send {
    font-size: 26rpx;
    color: #9F6B65;
    padding-left: 20rpx;
    font-weight: bold;
}

/* 分页 */
.pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24rpx 30rpx 10rpx;
}

.page-btn {
    margin: 0 !important;
    min-width: 150rpx;
    height: 66rpx;
    line-height: 66rpx;
    font-size: 26rpx;
    color: #9F6B65;
    background: #fff;
    border: 1rpx solid rgba(159, 107, 101, 0.3);
    border-radius: 33rpx;
    padding: 0 !important;
}

.page-btn[disabled] {
    color: #bbb;
    border-color: #e5e5e5;
    background: #f7f7f7;
}

.page-info {
    font-size: 24rpx;
    color: #999;
}

/* 悬浮打卡按钮 */
.checkin-fab {
    position: fixed;
    right: 36rpx;
    bottom: 160rpx;
    z-index: 900;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 120rpx;
    height: 120rpx;
    border-radius: 60rpx;
    background: linear-gradient(135deg, #9F6B65 0%, #8B5A50 100%);
    box-shadow: 0 8rpx 24rpx rgba(159, 107, 101, 0.45);
}

.checkin-fab:active {
    opacity: 0.85;
    transform: scale(0.96);
}

.checkin-fab-icon {
    font-size: 40rpx;
    color: #fff;
    line-height: 1;
}

.checkin-fab-text {
    font-size: 20rpx;
    color: #fff;
    margin-top: 2rpx;
}

/* 弹窗 */
.modal-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 999;
}

.check-in-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 90%;
    max-width: 600rpx;
    background: #fff;
    border-radius: 16rpx;
    z-index: 1000;
    box-sizing: border-box;
    overflow: hidden;
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20rpx 30rpx;
    background: linear-gradient(135deg, #9F6B65 0%, #8B5A50 100%);
    color: #fff;
}

.modal-title {
    font-size: 32rpx;
    font-weight: bold;
}

.modal-close {
    width: 60rpx !important;
    height: 60rpx !important;
    line-height: 60rpx !important;
    text-align: center !important;
    background: rgba(255, 255, 255, 0.2) !important;
    color: #fff !important;
    border-radius: 50% !important;
    font-size: 32rpx !important;
    padding: 0 !important;
    margin: 0 !important;
    border: none !important;
}

.modal-close::after {
    content: none !important;
}

.modal-body {
    padding: 30rpx;
    box-sizing: border-box;
}

.form-item {
    margin-bottom: 30rpx;
    width: 100%;
    box-sizing: border-box;
}

.form-label {
    display: block;
    margin-bottom: 10rpx;
    color: #333;
    font-size: 28rpx;
}

.form-input {
    width: 100%;
    padding: 20rpx;
    border: 2rpx solid #9F6B65;
    border-radius: 24rpx;
    font-size: 28rpx;
    box-sizing: border-box;
}

.form-textarea {
    width: 100%;
    padding: 20rpx;
    border: 2rpx solid #9F6B65;
    border-radius: 24rpx;
    font-size: 28rpx;
    box-sizing: border-box;
    min-height: 150rpx;
}

.fy-name-tips {
    font-size: 24rpx;
    color: #4c89e3;
    margin-top: 10rpx;
    display: block;
}

.image-upload {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
}

.choose-img-btn {
    width: 220rpx !important;
    height: 80rpx !important;
    background: linear-gradient(135deg, #9F6B65 0%, #8B5A50 100%) !important;
    color: #fff !important;
    border-radius: 24rpx !important;
    font-size: 28rpx !important;
    line-height: 80rpx !important;
    padding: 0 !important;
}

.preview-img {
    width: 200rpx;
    height: 200rpx;
    border-radius: 8rpx;
    border: 1rpx solid #e5e5e5;
}

.modal-footer {
    padding: 20rpx 30rpx;
    border-top: 1rpx solid #f5f5f5;
    text-align: center;
    box-sizing: border-box;
}

.submit-check-in-btn {
    width: 100% !important;
    height: 80rpx !important;
    background: linear-gradient(135deg, #9F6B65 0%, #8B5A50 100%) !important;
    color: #fff !important;
    border-radius: 24rpx !important;
    font-size: 32rpx !important;
    font-weight: bold !important;
    line-height: 80rpx !important;
    padding: 0 !important;
    margin: 0 !important;
}
