/* 背景图 */
.bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
}

.bg image {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* 变淡遮罩 */
.bg-mask {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.6);
}

.container {
    padding: 20rpx;
    background: linear-gradient(135deg, #FFFBEE 0%, #FFF3D8 100%);
    position: relative; 
    z-index: 1;  
    min-height: 100vh;
}

/* 标签切换 */
.tab-switch {
    display: flex;
    margin-bottom: 20rpx;
    border-radius: 10rpx;
    overflow: hidden;
    border: 1px solid #eee;
    background: rgba(255, 255, 255, 0.8) !important; 
}

.tab-btn {
    flex: 1;
    height: 60rpx;
    line-height: 40rpx;
    background-color: #fff;
    border: none;
    border-right: 1px solid #eee;
    font-size: 28rpx;
}

.tab-btn:last-child {
    border-right: none;
}

.tab-btn.active {
    background-color: #B98B85;
    color: #fff;
    position: relative;
}

/* 激活态底部线条 */
.tab-btn.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 4rpx;
    background-color: #A87B75;
}

/* 搜索框 */
.search-box {
    display: flex;
    gap: 5rpx;
    margin-bottom: 20rpx;
    padding: 0 10rpx;
    border-radius: 30px;
}

.search-input {
    width: 100%;
    height: 80rpx;
    padding: 0 20rpx;
    background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(249,249,249,0.95) 100%) !important;
    border-radius: 40rpx;
    border: 2rpx solid #9F6B65;
    font-size: 28rpx;
}



/* 分页 */
.pagination {
    width: 95%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx;
    background: rgba(255, 255, 255, 0.7) !important;
    margin-bottom: 20rpx;
    border-radius: 10rpx;
    border: 1px solid #eee;
    font-size: 30rpx;
}

.count {
    display: flex;
    gap: 30rpx;
    margin-top: 20rpx;
}

.page {
    display: flex;
    gap: 10rpx;
}

.flex-count {
    display: flex;
}

.page-size-input {
    width: 50rpx;
    height: 40rpx;
    text-align: center;
    border-radius: 6rpx;
    background: #f0f0f0;
}

.pagination button {
    width: 300rpx;
    padding: 10rpx 20rpx;
    border: 1px solid #eee;
    border-radius: 20rpx;
    background-color: #fff;
}

.pagination button:disabled {
    color: #999;
    background-color: #f8f8f8;
}

/* 列表容器 */
.list-container {
    background: linear-gradient(135deg, rgba(255,255,255,0.75) 0%, rgba(249,249,249,0.75) 100%) !important;
    border-radius: 24rpx;
    padding: 0;
    border: 1rpx solid rgba(159, 107, 101, 0.1);
    width: 100%;
    box-shadow: 0 8rpx 32rpx rgba(159, 107, 101, 0.15);
}

/* 列表标题栏 */
.list-header {
    display: flex;
    padding: 20rpx;
    border-bottom: 2rpx solid #f0f0f0;
    background-color: #fafafa;
    width: 100%;
}

.list-header-item {
    flex: 1;
    font-weight: bold;
    font-size: 28rpx;
    color: #333;
}

/* 列表项 */
.list-item {
    padding: 30rpx;
    border-bottom: none;
    background: linear-gradient(135deg, rgba(255,255,255,0.8) 0%, rgba(249,249,249,0.8) 100%);
    border-radius: 20rpx;
    margin: 20rpx;
    box-shadow: 0 4rpx 16rpx rgba(159, 107, 101, 0.1);
}



.list-item:active {
    transform: scale(0.98);
    box-shadow: 0 2rpx 8rpx rgba(159, 107, 101, 0.15);
}

/* 列表项头部 */
.item-header {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
}

/* 打卡图片 */
.item-image {
    margin-top: 20rpx;
    padding-top: 20rpx;
    border-top: 1rpx solid rgba(159, 107, 101, 0.1);
}

.checkin-image {
    width: 100%;
    max-height: 400rpx;
    border-radius: 12rpx;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}

/* 用户信息 */
.user-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

/* 用户行 */
.user-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* 用户名 */
.user-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 8rpx;
}

/* 打卡时间 */
.checkin-time {
    font-size: 24rpx;
    color: #999;
}

/* 列表项内容 */
.item-content {
    padding-top: 20rpx;
    border-top: 1rpx solid rgba(159, 107, 101, 0.1);
}

/* 非遗名称 */
.fy-name {
    font-size: 28rpx;
    color: #9F6B65;
    margin-top: 10rpx;
    font-weight: 500;
}

/* 打卡内容 */
.checkin-text {
    font-size: 28rpx;
    color: #333;
    line-height: 1.6;
}

.item-row::before {
    content: '';
    position: absolute;
    left: -20rpx;
    top: 16rpx;
    width: 8rpx;
    height: 8rpx;
    background-color: #FFA500;
    border-radius: 50%;
}

.label {
    font-weight: bold;
    width: 120rpx;
    display: inline-block;
    color: #333;
    font-size: 28rpx;
}

.item-row text {
    flex: 1;
    font-size: 28rpx;
    color: #666;
    line-height: 1.5;
}

.item-img {
    width: 200rpx;
    height: auto;
    margin-top: 10rpx;
    border-radius: 8rpx;
    border: 1px solid #eee;
    padding: 5rpx;
}

/* 空数据提示 */
.empty-tip {
    text-align: center;
    padding: 60rpx 0;
    color: #999;
    font-size: 28rpx;
    border: 1px dashed #eee;
    margin: 20rpx;
    border-radius: 10rpx;
}

.container { padding: 24rpx; box-sizing: border-box; }
.tab-switch { border-radius: 16rpx; border-color: rgba(159,107,101,.16); box-shadow: 0 6rpx 18rpx rgba(159,107,101,.07); }
.tab-btn { height: 80rpx; line-height: 80rpx; background: rgba(255,255,255,.86); }
.tab-btn:active { opacity: .82; }
.search-box { padding: 0; margin: 24rpx 0; }
.search-input { box-sizing: border-box; border: 1rpx solid rgba(159,107,101,.5); background: rgba(255,255,255,.9) !important; }
.list-container { border-color: rgba(159,107,101,.14); box-shadow: 0 8rpx 24rpx rgba(159,107,101,.09); }
.list-header { padding: 26rpx 30rpx; background: rgba(255,249,230,.8); box-sizing: border-box; }
.list-item { border: 1rpx solid rgba(159,107,101,.1); }
.pagination { width: 100%; box-sizing: border-box; border-radius: 16rpx; border-color: rgba(159,107,101,.14); }
.pagination button { min-height: 72rpx; line-height: 72rpx; border-color: rgba(159,107,101,.22); color: #9F6B65; }

/* 打卡查询页面的暖色卡片层级 */
.tab-switch { padding: 8rpx; gap: 8rpx; background: rgba(255,255,255,.78) !important; border-radius: 16rpx; box-shadow: 0 6rpx 18rpx rgba(159,107,101,.07); }
.tab-btn { height: 80rpx; line-height: 80rpx; border-radius: 12rpx; color: #765a54; }
.tab-btn.active { background: #B98B85; box-shadow: 0 4rpx 10rpx rgba(159,107,101,.18); }
.search-box { padding: 16rpx; background: rgba(255,255,255,.5); border-radius: 18rpx; }
.list-header { padding: 26rpx 30rpx; border-radius: 20rpx 20rpx 0 0; background: rgba(255,249,230,.8); }
.list-item { margin: 16rpx; padding: 26rpx; border: 1rpx solid rgba(159,107,101,.1); }
.user-name { color: #4a3a37; }
.fy-name { display: inline-block; padding: 8rpx 14rpx; background: #fff3d8; border-radius: 10rpx; }
.checkin-text { color: #5d4a45; }
.checkin-image { border: 1rpx solid rgba(159,107,101,.14); }
