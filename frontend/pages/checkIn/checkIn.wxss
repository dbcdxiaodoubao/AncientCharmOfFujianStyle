page { background: var(--paper, #f6f2e9); }
.feed-page { min-height:100vh; padding-bottom:190rpx; box-sizing:border-box; }

.page-hero { display:flex; align-items:center; gap:22rpx; margin:20rpx 24rpx 0; padding:22rpx; background:rgba(255,253,248,.92); border:1rpx solid #fff; border-radius:26rpx; box-shadow:var(--shadow, 0 8rpx 24rpx rgba(72,64,45,.08)); }
.hero-art { width:150rpx; height:112rpx; flex-shrink:0; border-radius:18rpx; background:#e7e2d6; }
.hero-copy { display:flex; flex-direction:column; min-width:0; }
.hero-eyebrow { color:var(--olive, #596638); font-size:22rpx; }
.hero-title { margin-top:8rpx; color:var(--ink, #2f3029); font-family:'Songti SC','STSong',serif; font-size:38rpx; font-weight:600; }
.hero-subtitle { margin-top:4rpx; color:var(--muted, #777263); font-size:23rpx; }

.tag-panel { margin:18rpx 24rpx 0; padding-top:20rpx; background:rgba(255,253,248,.92); border:1rpx solid #fff; border-radius:26rpx; box-shadow:var(--shadow, 0 8rpx 24rpx rgba(72,64,45,.08)); box-sizing:border-box; }
.tag-search { display:flex; align-items:center; margin:0 24rpx; height:64rpx; padding:0 24rpx; background:#f1eee5; border:1rpx solid var(--line, #ded8c8); border-radius:32rpx; box-sizing:border-box; }
.tag-search-icon { font-size:24rpx; color:var(--muted, #777263); margin-right:12rpx; }
.tag-search-input { flex:1; min-width:0; font-size:26rpx; color:var(--ink, #2f3029); }
.tag-search-ph { color:var(--muted, #777263); }
.tag-bar { display:flex; align-items:center; padding:14rpx 24rpx 12rpx; box-sizing:border-box; }
.tag-scroll { flex:1; min-width:0; white-space:nowrap; }
.tag-row { display:inline-flex; align-items:center; gap:12rpx; padding-right:8rpx; }
.tag-wrap { flex:1; min-width:0; display:flex; flex-wrap:wrap; gap:12rpx; }
.tag { display:flex; align-items:center; gap:8rpx; flex-shrink:0; min-height:56rpx; padding:10rpx 18rpx; border:1rpx solid var(--line, #ded8c8); border-radius:18rpx; background:#f3f0e9; color:#625e53; font-size:24rpx; box-sizing:border-box; }
.tag.active { background:var(--olive, #596638); color:#fff; border-color:var(--olive, #596638); }
.tag-name { max-width:340rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.tag-count { opacity:.8; font-size:21rpx; }
.tag-toggle { flex-shrink:0; margin-left:12rpx; padding:8rpx 10rpx; color:var(--olive, #596638); font-size:23rpx; white-space:nowrap; }

.feed { margin-top:18rpx; }
.feed-status { padding:68rpx 22rpx; text-align:center; color:var(--muted, #777263); font-size:26rpx; line-height:1.8; background:rgba(255,253,248,.65); border-radius:26rpx; }
.moment { display:flex; align-items:flex-start; margin:0 24rpx 18rpx; padding:24rpx 22rpx; background:rgba(255,253,248,.94); border:1rpx solid #fff; border-radius:26rpx; box-shadow:var(--shadow, 0 8rpx 24rpx rgba(72,64,45,.08)); }
.moment-avatar { width:70rpx; height:70rpx; flex-shrink:0; display:flex; align-items:center; justify-content:center; border:3rpx solid #fff; border-radius:22rpx; color:#fff; font-size:32rpx; font-weight:600; }
.moment-body { flex:1; min-width:0; margin-left:18rpx; }
.moment-name { color:var(--olive, #596638); font-size:28rpx; font-weight:600; word-break:break-all; }
.moment-text { margin-top:12rpx; color:var(--ink, #2f3029); font-size:28rpx; line-height:1.8; word-break:break-word; }
.moment-media { margin-top:16rpx; }
.moment-image { width:420rpx; max-width:100%; border-radius:18rpx; background:#e8e5d9; }
.moment-meta { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; margin-top:18rpx; }
.moment-time { color:var(--muted, #777263); font-size:22rpx; }
.moment-fy { padding:4rpx 12rpx; color:#596638; background:#e8ecdf; border-radius:10rpx; font-size:21rpx; word-break:break-all; }
.moment-heat { color:#a0522d; font-size:22rpx; }
.moment-actions { display:flex; gap:32rpx; margin-top:18rpx; }
.action { display:flex; align-items:center; gap:8rpx; min-height:56rpx; }
.action-icon { font-size:28rpx; }
.action-count { color:var(--muted, #777263); font-size:24rpx; }
.action.active .action-count { color:#a0522d; }
.comment-panel { margin-top:16rpx; padding:18rpx; background:#f0eee5; border-radius:18rpx; }
.comment-item { margin-bottom:6rpx; color:var(--ink, #2f3029); font-size:25rpx; line-height:1.8; word-break:break-word; }
.comment-user { color:#596638; font-weight:500; }
.comment-empty, .comment-placeholder { color:#716b60; font-size:23rpx; }
.comment-input-row { display:flex; align-items:center; margin-top:16rpx; padding-top:14rpx; border-top:1rpx solid var(--line, #ded8c8); }
.comment-input { flex:1; min-width:0; height:64rpx; font-size:25rpx; }
.comment-send { padding:12rpx 0 12rpx 20rpx; color:var(--olive, #596638); font-size:25rpx; }

.pagination { display:flex; align-items:center; justify-content:space-between; gap:14rpx; margin:0 24rpx; padding:18rpx 0; }
.page-btn { min-width:126rpx; height:70rpx; margin:0; padding:0 16rpx; border:1rpx solid var(--line, #ded8c8); border-radius:20rpx; background:#faf8f2; color:var(--olive, #596638); font-size:24rpx; line-height:70rpx; }
.page-info { color:var(--muted, #777263); font-size:22rpx; text-align:center; }
.checkin-fab { position:fixed; right:28rpx; bottom:38rpx; bottom:calc(38rpx + env(safe-area-inset-bottom)); z-index:90; display:flex; align-items:center; justify-content:center; gap:10rpx; padding:18rpx 28rpx; border:2rpx solid #fff; border-radius:50rpx; color:#fff; background:var(--olive, #596638); box-shadow:0 8rpx 26rpx rgba(89,102,56,.22); }
.checkin-fab-icon { font-size:34rpx; line-height:1; }
.checkin-fab-text { font-size:26rpx; }

.modal-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:999; background:rgba(56,60,48,.42); }
.check-in-modal { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); width:calc(100% - 40rpx); max-width:690rpx; max-height:86vh; display:flex; flex-direction:column; z-index:1000; overflow:hidden; border:1rpx solid #fff; border-radius:28rpx; background:#fbf9f3; box-shadow:0 20rpx 60rpx rgba(56,60,48,.2); box-sizing:border-box; }
.modal-header { display:flex; flex-shrink:0; align-items:center; justify-content:space-between; padding:22rpx 28rpx; border-bottom:1rpx solid var(--line, #ded8c8); }
.modal-title { color:var(--ink, #2f3029); font-family:'Songti SC','STSong',serif; font-size:34rpx; font-weight:600; }
.modal-close { width:64rpx; height:64rpx; margin:0; padding:0; border-radius:50%; background:#ebe7dd; color:#625e53; font-size:36rpx; line-height:64rpx; }
.modal-body { flex:1; min-height:0; overflow-y:auto; padding:26rpx 28rpx; box-sizing:border-box; }
.form-item { margin-bottom:24rpx; }
.form-label { display:block; margin-bottom:14rpx; color:#625e53; font-size:26rpx; }
.form-input, .form-textarea { width:100%; padding:18rpx 22rpx; border:1rpx solid var(--line, #ded8c8); border-radius:18rpx; background:#f1eee5; color:var(--ink, #2f3029); font-size:27rpx; box-sizing:border-box; }
.form-input { height:84rpx; }
.form-textarea { height:160rpx; line-height:1.7; }
.fy-selected { display:flex; align-items:center; gap:12rpx; margin-bottom:12rpx; padding:12rpx 18rpx; border-radius:14rpx; background:#e5eada; }
.fy-selected-name { flex:1; min-width:0; color:#536035; font-size:24rpx; word-break:break-all; }
.fy-clear { padding:6rpx; color:#625e53; font-size:32rpx; }
.fy-options { max-height:260rpx; margin-top:12rpx; border:1rpx solid var(--line, #ded8c8); border-radius:16rpx; box-sizing:border-box; }
.fy-option { display:flex; align-items:center; gap:16rpx; padding:18rpx; border-bottom:1rpx solid var(--line, #ded8c8); font-size:25rpx; }
.fy-option:last-child { border-bottom:0; }
.fy-option.active { background:#e5eada; color:#536035; }
.fy-option-name { flex:1; min-width:0; word-break:break-all; }
.fy-option-city { flex-shrink:0; color:var(--muted, #777263); font-size:22rpx; }
.fy-empty { padding:18rpx; color:var(--muted, #777263); font-size:24rpx; text-align:center; }
.image-upload { display:flex; flex-wrap:wrap; align-items:center; gap:18rpx; }
.choose-img-btn { min-height:80rpx; margin:0; padding:0 24rpx; border:1rpx solid #a6b3a7; border-radius:18rpx; background:#e7ebdd; color:#596638; font-size:26rpx; line-height:80rpx; }
.preview-img { width:150rpx; height:150rpx; border-radius:18rpx; }
.modal-footer { flex-shrink:0; padding:20rpx 28rpx 28rpx; border-top:1rpx solid var(--line, #ded8c8); background:#fbf9f3; }
.submit-check-in-btn { width:100%; height:88rpx; margin:0; padding:0; border-radius:20rpx; background:#596638; color:#fff; font-size:30rpx; line-height:88rpx; }
