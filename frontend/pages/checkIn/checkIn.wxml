<view class="feed-page">
    <!-- 非遗标签筛选（标签=非遗id+名称，按打卡数降序）-->
    <view class="tag-bar">
        <view class="tag {{selectedFyId === '' ? 'active' : ''}}" bindtap="onAllTagTap">全部</view>
        <view class="tag {{selectedFyId === item.fyId ? 'active' : ''}}"
              wx:for="{{displayTags}}" wx:key="fyId"
              data-fyid="{{item.fyId}}" bindtap="onTagTap">
            <text class="tag-name">{{item.fyName}}</text>
            <text class="tag-count">{{item.count}}</text>
        </view>
        <view class="tag-more" wx:if="{{tags.length > 6}}" bindtap="onToggleTagExpand">
            {{tagsExpanded ? '收起 ▲' : '展开更多 ▼'}}
        </view>
    </view>

    <!-- 动态流 -->
    <view class="feed">
        <view class="feed-status" wx:if="{{loading}}">正在加载动态…</view>
        <view class="feed-status" wx:if="{{!loading && checkInList.length === 0}}">还没有打卡动态，点右下角发一条吧～</view>

        <view class="moment" wx:for="{{checkInList}}" wx:key="id">
            <view class="moment-avatar" style="background: {{item.avatarColor}};">{{item.avatarText}}</view>
            <view class="moment-body">
                <view class="moment-name">{{item.userName || '匿名用户'}}</view>
                <view class="moment-text" wx:if="{{item.txt}}">{{item.txt}}</view>
                <view class="moment-media" wx:if="{{item.displayPictureUrl}}">
                    <image class="moment-image" src="{{item.displayPictureUrl}}" mode="widthFix" lazy-load
                           bindtap="onImageTap" data-image="{{item.displayPictureUrl}}" />
                </view>
                <view class="moment-meta">
                    <text class="moment-time">{{item.showTime}}</text>
                    <text class="moment-fy" wx:if="{{item.fyName}}">#{{item.fyName}}</text>
                    <text class="moment-heat" wx:if="{{item.heat > 0}}">🔥{{item.heat}}</text>
                </view>

                <view class="moment-actions">
                    <view class="action {{item.liked ? 'active' : ''}}" catchtap="onToggleLike" data-id="{{item.id}}">
                        <text class="action-icon">{{item.liked ? '❤️' : '🤍'}}</text>
                        <text class="action-count">{{item.likeCount}}</text>
                    </view>
                    <view class="action" catchtap="onToggleComments" data-id="{{item.id}}">
                        <text class="action-icon">💬</text>
                        <text class="action-count">{{item.commentCount}}</text>
                    </view>
                </view>

                <view class="comment-panel" wx:if="{{item.showComments}}">
                    <view class="comment-item" wx:for="{{item.comments}}" wx:for-item="comment" wx:key="id">
                        <text class="comment-user">{{comment.userName}}：</text>
                        <text class="comment-content">{{comment.content}}</text>
                    </view>
                    <view class="comment-empty" wx:if="{{item.commentsLoaded && item.comments.length === 0}}">还没有评论，快来抢沙发～</view>
                    <view class="comment-input-row">
                        <input class="comment-input" value="{{commentDraft[item.id]}}" placeholder="写评论…"
                               placeholder-class="comment-placeholder" data-id="{{item.id}}" bindinput="onCommentInput" />
                        <text class="comment-send" catchtap="onSendComment" data-id="{{item.id}}">发送</text>
                    </view>
                </view>
            </view>
        </view>
    </view>

    <!-- 分页 -->
    <view class="pagination" wx:if="{{!loading && total > 0}}">
        <button class="page-btn" bindtap="changePage" data-type="prev" disabled="{{pageNum <= 1}}">上一页</button>
        <text class="page-info">{{pageNum}} / {{totalPages}}（共{{total}}条）</text>
        <button class="page-btn" bindtap="changePage" data-type="next" disabled="{{pageNum >= totalPages}}">下一页</button>
    </view>

    <!-- 悬浮打卡按钮 -->
    <view class="checkin-fab" bindtap="openCheckInModal">
        <text class="checkin-fab-icon">＋</text>
        <text class="checkin-fab-text">打卡</text>
    </view>

    <!-- 上传打卡弹窗 -->
    <view class="modal-mask" wx:if="{{checkInVisible}}" bindtap="closeCheckInModal"></view>
    <view class="check-in-modal" wx:if="{{checkInVisible}}">
        <view class="modal-header">
            <text class="modal-title">发布打卡</text>
            <button class="modal-close" bindtap="closeCheckInModal">×</button>
        </view>
        <view class="modal-body">
            <view class="form-item">
                <text class="form-label">选择非遗：</text>
                <view class="fy-selected" wx:if="{{fyName}}">
                    <text class="fy-selected-name">已选：{{fyName}}</text>
                    <text class="fy-clear" catchtap="clearFySelection">×</text>
                </view>
                <input class="form-input" placeholder="搜索非遗名称" value="{{fySearchKey}}" bindinput="onFySearchInput" />
                <scroll-view class="fy-options" scroll-y wx:if="{{filteredFyOptions.length > 0}}">
                    <view class="fy-option {{fyId === item.id ? 'active' : ''}}"
                          wx:for="{{filteredFyOptions}}" wx:key="id"
                          data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onSelectFy">
                        <text class="fy-option-name">{{item.name}}</text>
                        <text class="fy-option-city" wx:if="{{item.cityName}}">{{item.cityName}}</text>
                    </view>
                </scroll-view>
                <view class="fy-empty" wx:if="{{fySearchKey && filteredFyOptions.length === 0}}">没有找到匹配的非遗</view>
            </view>
            <view class="form-item">
                <text class="form-label">打卡文本：</text>
                <textarea class="form-textarea" placeholder="这一刻的想法…" value="{{checkInTxt}}"
                    bindinput="inputCheckInTxt"></textarea>
            </view>
            <view class="form-item">
                <text class="form-label">打卡图片：</text>
                <view class="image-upload">
                    <button class="choose-img-btn" bindtap="chooseCheckInImage" disabled="{{checkInLoading}}">
                        {{tempImagePath ? '更换图片' : '选择图片'}}
                    </button>
                    <image class="preview-img" src="{{tempImagePath}}" mode="aspectFill" wx:if="{{tempImagePath}}"></image>
                </view>
            </view>
        </view>
        <view class="modal-footer">
            <button class="submit-check-in-btn" bindtap="uploadCheckIn" loading="{{checkInLoading}}"
                disabled="{{checkInLoading}}">发布</button>
        </view>
    </view>
</view>
