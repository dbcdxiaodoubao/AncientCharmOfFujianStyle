.detail-header { display:flex; align-items:flex-start; padding:28rpx; margin-bottom:24rpx; box-sizing:border-box; }
.detail-image { width:156rpx; height:180rpx; flex-shrink:0; margin-right:24rpx; border-radius:20rpx; }
.detail-title-section { flex:1; min-width:0; }
.detail-title { display:block; font-family:'Songti SC','STSong',serif; font-size:36rpx; font-weight:700; line-height:1.5; margin-bottom:14rpx; word-break:break-all; }
.detail-category { display:inline-block; padding:6rpx 14rpx; background:#e8ecdf; color:#536035; font-size:23rpx; border-radius:12rpx; }
.favorite-button { display:inline-block; min-height:68rpx; line-height:68rpx; padding:0 28rpx; margin:20rpx 0 0; font-size:25rpx; color:#596638; background:#f4f1e9; border:1rpx solid #a6b3a7; border-radius:34rpx; }
.favorite-button.is-favorite { color:#fff; background:#596638; border-color:#596638; }
.detail-content { padding:30rpx; box-sizing:border-box; }
.detail-section-title { margin-bottom:24rpx; padding-bottom:18rpx; border-bottom:1rpx solid var(--line); }
.description-text { display:block; font-size:29rpx; color:#4e5045; line-height:1.95; word-break:break-word; }
