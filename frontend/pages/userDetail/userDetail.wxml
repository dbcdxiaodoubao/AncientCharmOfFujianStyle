<view class="user-detail-container container">
    <!-- 用户信息展示 -->
    <view class="info-card">
        <view class="info-item">
            <text class="label">用户ID：</text>
            <text class="value">{{userInfo.userId}}</text>
        </view>
        <view class="info-item">
            <text class="label">用户名：</text>
            <text class="value">{{userInfo.userName}}</text>
        </view>
        <view class="info-item">
            <text class="label">账号状态：</text>
            <text class="value">{{userInfo.status}}</text>
        </view>
    </view>

    <view class="profile-section">
        <view class="section-head">
            <text class="section-title">我的收藏</text>
            <text class="section-caption">点击查看非遗项目详情</text>
        </view>
        <view class="section-loading" wx:if="{{favoriteLoading}}">收藏加载中...</view>
        <view class="section-empty" wx:elif="{{favoriteLoaded && favoriteList.length === 0}}">暂未收藏非遗项目</view>
        <view class="favorite-item" wx:for="{{favoriteList}}" wx:key="fyId" bindtap="goFavoriteDetail" data-fy-id="{{item.fyId}}">
            <text class="favorite-name">{{item.name}}</text>
            <text class="favorite-arrow">查看 ></text>
        </view>
    </view>

    <view class="profile-section">
        <view class="section-head">
            <text class="section-title">推荐偏好</text>
            <text class="section-caption">选择后保存，用于个性化推荐</text>
        </view>
        <view class="section-loading" wx:if="{{preferenceLoading}}">偏好加载中...</view>
        <view wx:else>
            <text class="preference-label">偏好城市</text>
            <view class="option-list">
                <view class="option-chip {{preferenceCity === item.id ? 'selected' : ''}}" wx:for="{{cityOptions}}" wx:key="id" bindtap="selectPreferenceCity" data-city="{{item.id}}">{{item.name}}</view>
            </view>
            <text class="preference-label">偏好类别</text>
            <view class="option-list">
                <view class="option-chip {{preferenceCategory === item ? 'selected' : ''}}" wx:for="{{categoryOptions}}" wx:key="*this" bindtap="selectPreferenceCategory" data-value="{{item}}">{{item}}</view>
            </view>
            <button class="save-preference-btn" bindtap="savePreference" loading="{{preferenceSaving}}" disabled="{{preferenceSaving}}">保存偏好</button>
        </view>
    </view>
    <!-- 功能列表 -->
    <view class="func-list">
        <view class="func-item" bindtap="showUserListManual" disabled="{{loading}}">
            <view class="func-icon userlist-icon"></view>
            <text class="func-text">账户信息</text>
            <view class="func-arrow"></view>
        </view>

        <view class="func-item" bindtap="goMyCheckIn">
            <view class="func-icon record-icon"></view>
            <text class="func-text">我的打卡</text>
            <view class="func-arrow"></view>
        </view>

        <view class="func-item" bindtap="handleLogout">
            <view class="func-icon logout-icon"></view>
            <text class="func-text">退出登录</text>
            <view class="func-arrow"></view>
        </view>
    </view>

    <!-- 账户信息 弹窗模式 -->
    <view class="modal-mask" wx:if="{{showUserList}}" bindtap="closeUserList"></view>
    <view class="user-list-modal" wx:if="{{showUserList}}">
        <view class="list-header">
            <text class="list-title">账户信息</text>
            <button class="close-btn" bindtap="closeUserList">×</button>
        </view>

        <view class="modal-body-scroll">
            <view class="loading" wx:if="{{loading}}">加载中...</view>
            <view class="list-item" wx:for="{{userList}}" wx:key="userId">
                <view class="list-item-row">
                    <text class="list-label">用户名：</text>
                    <text class="list-value">{{item.userName}}</text>
                </view>
                <view class="list-item-row">
                    <text class="list-label">用户ID：</text>
                    <text class="list-value">{{item.userId}}</text>
                </view>
                <view class="list-item-row">
                    <text class="list-label">创建时间：</text>
                    <text class="list-value">{{item.formatCreateTime}}</text>
                </view>
                <view class="list-divider"></view>
            </view>
        </view>
    </view>
</view>

