.info-card, .profile-section, .func-list { padding:28rpx; box-sizing:border-box; margin-bottom:24rpx; width:100%; }
.profile-heading { display:flex; gap:22rpx; align-items:center; padding-bottom:24rpx; margin-bottom:12rpx; border-bottom:1rpx solid var(--line); }
.profile-avatar { flex-shrink:0; width:104rpx; height:104rpx; line-height:104rpx; text-align:center; border-radius:50%; background:linear-gradient(140deg,#e9e3d5,#ccd6bf); border:5rpx solid #fff; color:#67764e; font-family:'Songti SC','STSong',serif; font-size:48rpx; }
.profile-heading-copy { min-width:0; }
.profile-name { display:block; font-family:'Songti SC','STSong',serif; font-size:36rpx; font-weight:700; word-break:break-all; }
.info-item { display:flex; padding:9rpx 0; gap:18rpx; font-size:25rpx; }
.label { width:142rpx; flex-shrink:0; color:var(--muted); }
.value { flex:1; min-width:0; color:var(--ink); word-break:break-all; }
.section-head { margin-bottom:22rpx; }
.section-loading, .section-empty, .loading { padding:24rpx 0; color:var(--muted); font-size:25rpx; }
.favorite-item { display:flex; gap:18rpx; align-items:center; justify-content:space-between; min-height:86rpx; padding:12rpx 18rpx; box-sizing:border-box; margin-top:12rpx; background:#f1f0e7; border:1rpx solid var(--line); border-radius:18rpx; }
.favorite-name { flex:1; min-width:0; font-size:27rpx; word-break:break-all; }
.favorite-arrow { color:var(--olive); flex-shrink:0; font-size:23rpx; }
.preference-label { display:block; margin:22rpx 0 14rpx; color:#625e53; font-size:26rpx; font-weight:600; }
.option-list { display:flex; flex-wrap:wrap; gap:12rpx; }
.option-chip { display:flex; align-items:center; justify-content:center; min-height:68rpx; padding:4rpx 20rpx; border-radius:18rpx; background:#f3f0e9; border:1rpx solid var(--line); color:#625e53; font-size:25rpx; box-sizing:border-box; }
.option-chip.selected { color:#fff; background:var(--olive); border-color:var(--olive); box-shadow:0 4rpx 12rpx rgba(89,102,56,.14); }
.save-preference-btn { width:100%; min-height:88rpx; line-height:88rpx; margin:28rpx 0 0; padding:0; border-radius:20rpx; background:linear-gradient(120deg,#6b774a,#536035); color:#fff; font-size:29rpx; }
.func-list { padding:8rpx 26rpx; }
.func-item { display:flex; align-items:center; min-height:100rpx; gap:20rpx; border-bottom:1rpx solid var(--line); }
.func-item:last-child { border-bottom:0; }
.func-text { flex:1; font-size:28rpx; }
.func-icon { width:36rpx; height:36rpx; background-repeat:no-repeat; background-size:contain; }
.userlist-icon { background-image:url('/images/ui/me.png'); }
.record-icon { background-image:url('/images/ui/check.png'); }
.logout-icon { width:26rpx; height:26rpx; border:2rpx solid #8b7d6b; border-right:0; border-radius:4rpx; position:relative; }
.logout-icon::after { content:'›'; position:absolute; left:14rpx; top:-15rpx; color:#8b7d6b; font-size:42rpx; }
.func-arrow { width:12rpx; height:12rpx; border-top:2rpx solid #8b7d6b; border-right:2rpx solid #8b7d6b; transform:rotate(45deg); }
.func-item:active, .option-chip:active, .favorite-item:active { opacity:.75; }
.modal-mask { position:fixed; top:0; bottom:0; left:0; right:0; background:rgba(56,60,48,.4); z-index:999; }
.user-list-modal { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); width:calc(100% - 48rpx); max-height:80vh; display:flex; flex-direction:column; box-sizing:border-box; overflow:hidden; background:#fbf9f3; border:1rpx solid #fff; border-radius:28rpx; z-index:1000; box-shadow:0 20rpx 60rpx rgba(56,60,48,.18); }
.list-header { display:flex; align-items:center; justify-content:space-between; padding:24rpx 28rpx; border-bottom:1rpx solid var(--line); }
.list-title { font-size:32rpx; font-weight:600; font-family:'Songti SC','STSong',serif; }
.close-btn { width:64rpx; height:64rpx; margin:0; padding:0; line-height:64rpx; border-radius:50%; background:#ebe7dd; color:#625e53; font-size:36rpx; }
.modal-body-scroll { flex:1; min-height:0; padding:12rpx 28rpx 28rpx; overflow-y:auto; }
.list-item { padding:16rpx 0; }
.list-item-row { display:flex; gap:18rpx; margin:10rpx 0; font-size:26rpx; }
.list-label { flex-shrink:0; width:142rpx; color:var(--muted); }
.list-value { word-break:break-all; color:var(--ink); }
.list-divider { height:1rpx; margin-top:20rpx; background:var(--line); }
.func-item[disabled] { opacity:.5; }
