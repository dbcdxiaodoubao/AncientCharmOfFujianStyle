<view class="register-container">
  <view class="auth-hero">
    <image class="hero-art" src="/images/ui/fujian-landscape.jpg" mode="aspectFit" aria-hidden="true" />
    <view class="auth-heading">
    <text class="hero-eyebrow">福建 · 非遗寻踪</text>
  <!-- 标题 -->
  <view class="title">古韵闽风</view>
  <view class="subtitle">把你的足迹留在福建</view>
    </view>
  </view>
  <view class="auth-panel glass-card">
    <text class="auth-panel-title">开启非遗之旅</text>
  <!-- 用户名输入 -->
  <view class="input-item">
    <text class="input-label">用户名：</text>
    <input 
      class="input-content" 
      placeholder="请设置用户名" 
      bindinput="onUserNameInput" 
      value="{{userName}}"
      type="text"
    />
  </view>

  <!-- 密码输入 -->
  <view class="input-item">
    <text class="input-label">密码：</text>
    <input 
      class="input-content" 
      placeholder="请设置密码" 
      bindinput="onPasswordInput" 
      value="{{password}}"
      type="password"
    />
  </view>

  <!-- 确认密码 -->
  <view class="input-item">
    <text class="input-label">确认密码：</text>
    <input 
      class="input-content" 
      placeholder="请再次输入密码" 
      bindinput="onRePasswordInput" 
      value="{{rePassword}}"
      type="password"
    />
  </view>

  <!-- 注册按钮 -->
  <button class="register-btn" bindtap="handleRegister" loading="{{loading}}" disabled="{{loading}}">注册</button>
  <button class="back-btn" bindtap="gotoLogin" disabled="{{loading}}">返回登录</button>
  </view>
</view>
