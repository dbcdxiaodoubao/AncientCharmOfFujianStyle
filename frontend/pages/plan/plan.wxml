<view class="container page-shell">
<view class="page-hero"><image class="hero-art" src="/images/ui/fujian-landscape.jpg" mode="aspectFit" aria-hidden="true" /><view class="hero-copy"><text class="hero-eyebrow">福建 · 非遗旅程</text><text class="hero-title">路线规划</text><text class="hero-subtitle">串起城市，也串起手艺</text></view></view>
    <view class="main-card">
        <!-- 城市选择区 -->
        <view class="city-select-panel glass-card">
            <view class="select-item">
                <text class="label">出发城市：</text>
                <picker mode="selector" range="{{cityList}}" range-key="name" value="{{startCityIndex}}" bindchange="onStartCityChange">
                    <view class="picker-text">
                        {{selectedStartCity.name || '请选择'}}
                    </view>
                </picker>
            </view>
            <view class="select-item">
                <text class="label">结束城市：</text>
                <picker mode="selector" range="{{cityList}}" range-key="name" value="{{endCityIndex}}" bindchange="onEndCityChange">
                    <view class="picker-text">
                        {{selectedEndCity.name || '请选择'}}
                    </view>
                </picker>
            </view>
            <view class="plan-options">
                <view class="plan-option">
                    <text class="label">游玩天数：</text>
                    <input class="plan-number-input" type="number" value="{{days}}" bindinput="onDaysInput" />
                    <text class="plan-unit">天</text>
                </view>
                <view class="plan-option">
                    <text class="label">每天交通：</text>
                    <input class="plan-number-input" type="number" value="{{transportMinutes}}" bindinput="onTransportInput" />
                    <text class="plan-unit">分钟</text>
                </view>
            </view>
            <view class="plan-actions">
                <button class="plan-btn" bindtap="onPlanTap" loading="{{isLoading}}">生成路线</button>
                <button class="ai-plan-btn" bindtap="onAiPlanTap">AI推荐</button>
            </view>
        </view>

        <view class="route-intro" wx:if="{{!hasPlanned}}"><text class="intro-mark">旅</text><text class="intro-title">下一站，遇见传承</text><text class="section-caption">选择出发与结束城市，探索沿途非遗</text></view>
        <!-- 路线展示区 -->
        <view class="route-panel glass-card" wx:if="{{hasPlanned}}">
            <text class="section-title">沿途非遗</text><text class="section-caption">循着城市的脚步，遇见匠心与风物</text>
            <view class="loading-tip" wx:if="{{isLoading}}">
                <text>路线规划中...</text>
            </view>
            <view class="empty-tip" wx:if="{{!isLoading && routeList.length === 0}}">
                <text>暂无规划路线数据</text>
            </view>
            <block wx:for="{{routeList}}" wx:key="id" wx:if="{{!isLoading && routeList.length > 0}}">
                <view class="station-title">第{{item.day || 1}}天 · 第{{index + 1}}站</view>
                <view class="info-card glass-card" bindtap="onRouteCardTap" data-id="{{item.id}}">
                    <view class="info-item">
                        <text class="info-label">非遗名称：</text>
                        <text class="info-value">{{item.name}}</text>
                    </view>
                    <view class="info-item">
                        <text class="info-label">所属城市：</text>
                        <text class="info-value">{{item.cityName || '未知城市'}}</text>
                    </view>
                    <view class="info-item">
                        <text class="info-label">级别：</text>
                        <text class="info-value">{{item.levelName || '未知级别'}}</text>
                    </view>
                    <view class="info-item" wx:if="{{item.pictureUrl}}">
                        <image src="{{item.pictureUrl}}" class="info-image" mode="aspectFill" />
                    </view>
                </view>
            </block>
        </view>
    </view>

    <!-- AI 助手悬浮按钮 -->
    <view class="ai-float-btn" bindtap="onAiChatTap">
        <text class="ai-float-icon">AI</text>
        <text class="ai-float-text">问路线</text>
    </view>
</view>
