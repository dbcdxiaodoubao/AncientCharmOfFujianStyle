.main-card { background:transparent; }
.city-select-panel { padding:28rpx; margin-bottom:26rpx; box-sizing:border-box; }
.select-item { display:flex; align-items:center; gap:20rpx; margin-bottom:22rpx; }
.label { width:142rpx; flex-shrink:0; font-size:26rpx; color:#625e53; }
.select-item picker { flex:1; min-width:0; }
.picker-text { min-height:92rpx; padding:0 28rpx; display:flex; align-items:center; color:var(--ink); font-size:30rpx; font-weight:500; border-radius:20rpx; border:1rpx solid #fff; background:#f7f5ef; box-shadow:inset 3rpx 3rpx 9rpx rgba(139,125,107,.1),inset -3rpx -3rpx 9rpx #fff; box-sizing:border-box; }
.plan-btn { width:100%; min-height:90rpx; line-height:90rpx; padding:0; margin-top:28rpx; font-size:30rpx; color:#fff; background:linear-gradient(120deg,#6b774a,#536035); border-radius:22rpx; box-shadow:0 8rpx 18rpx rgba(89,102,56,.16); }
.route-panel { padding:28rpx; box-sizing:border-box; }
.station-title { display:flex; align-items:center; gap:14rpx; margin:28rpx 0 14rpx; color:var(--olive); font-size:25rpx; font-weight:600; }
.station-title::before { content:''; width:14rpx; height:14rpx; border-radius:50%; background:var(--olive); box-shadow:0 0 0 6rpx #e5e8da; }
.info-card { padding:24rpx; border-color:var(--line); margin-left:6rpx; }
.info-card:active { opacity:.82; }
.info-item { display:flex; align-items:baseline; gap:12rpx; margin-bottom:10rpx; min-width:0; }
.info-item:last-child { margin-bottom:0; }
.info-label { flex-shrink:0; font-size:24rpx; color:var(--muted); }
.info-value { font-size:27rpx; color:var(--ink); word-break:break-all; }
.info-image { width:100%; height:260rpx; margin-top:12rpx; border-radius:18rpx; }
.ai-float-btn { position:fixed; right:28rpx; bottom:38rpx; bottom:calc(38rpx + env(safe-area-inset-bottom)); z-index:90; display:flex; gap:12rpx; align-items:center; padding:18rpx 26rpx; border:2rpx solid rgba(255,255,255,.9); border-radius:50rpx; background:rgba(234,228,243,.96); color:#68547c; box-shadow:0 8rpx 24rpx rgba(98,81,118,.16); -webkit-backdrop-filter:blur(12px); backdrop-filter:blur(12px); }
.ai-float-icon { font-size:25rpx; font-weight:700; }
.ai-float-text { font-size:24rpx; }
.ai-float-btn:active { opacity:.8; }
.container { padding-bottom:170rpx; }
.route-intro { display:flex; flex-direction:column; align-items:center; padding:60rpx 16rpx; text-align:center; }
.intro-mark { width:100rpx; height:100rpx; line-height:100rpx; border-radius:50%; background:#e3e6d9; color:#758363; font-family:'Songti SC','STSong',serif; font-size:50rpx; margin-bottom:22rpx; }
.intro-title { font-family:'Songti SC','STSong',serif; font-size:32rpx; color:#625e53; }
.plan-options {
    display: flex;
    gap: 16rpx;
    margin: 18rpx 0 24rpx;
}

.plan-actions {
    display: flex;
    gap: 16rpx;
    margin-top: 28rpx;
}

.plan-actions .plan-btn {
    flex: 1;
    margin-top: 0;
}

.ai-plan-btn {
    flex: 0 0 190rpx;
    min-height: 90rpx;
    line-height: 90rpx;
    margin: 0;
    padding: 0 16rpx;
    border: 1rpx solid #a6b3a7;
    border-radius: 22rpx;
    background: #e7ebdd;
    color: #596638;
    font-size: 28rpx;
}

.plan-option {
    flex: 1;
    display: flex;
    align-items: center;
    min-width: 0;
    padding: 14rpx 16rpx;
    border: 1rpx solid var(--line, #ded8c8);
    border-radius: 16rpx;
    background: rgba(255, 253, 248, .9);
}

.plan-option .label {
    width: auto;
    flex-shrink: 0;
    font-size: 24rpx;
}

.plan-number-input {
    flex: 1;
    min-width: 0;
    margin-left: 10rpx;
    text-align: center;
    font-size: 28rpx;
    font-weight: 600;
    color: var(--olive, #596638);
}

.plan-unit {
    flex-shrink: 0;
    margin-left: 6rpx;
    color: var(--muted, #777263);
    font-size: 22rpx;
}
