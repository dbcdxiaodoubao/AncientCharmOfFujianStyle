.bg {
    position: fixed; 
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;  
    width: 100%;
    height: 100%;
    z-index: -1;
}

.bg image {
    width: 100%;
    height: 100%;
    object-fit: cover; 
}


.bg-mask {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(245, 233, 211, 0.8); 
    z-index: 0; 
}


.container {
    width: 100%;
    min-height: 100vh;
    background: linear-gradient(135deg, #FFFBEE 0%, #FFF3D8 100%);
    padding: 20rpx; 
    box-sizing: border-box;
    position: relative; 
    z-index: 1;
}

/* 主卡片容器 */
.main-card {
    background: linear-gradient(135deg, rgba(255,255,255,0.75) 0%, rgba(249,249,249,0.75) 100%);
    border-radius: 24rpx;
    padding: 40rpx;
    box-shadow: 0 8rpx 32rpx rgba(159, 107, 101, 0.15);
    border: 1rpx solid rgba(159, 107, 101, 0.1);
}

/* 城市选择面板 */
.city-select-panel {
    width: 100%;
    background: transparent !important;
    padding: 0;
    margin-bottom: 30rpx;
    box-shadow: none;
    box-sizing: border-box;
    position: relative;
    border: none;
}

/* 选择项行布局 */
.select-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-bottom: 25rpx;
    box-sizing: border-box;
}

/* 标签样式 */
.label {
    font-size: 28rpx;
    color: #333;
    width: 120rpx;
    flex-shrink: 0;
    white-space: nowrap;
}

/* 选择器文本框 */
.picker-text {
    flex: 1;
    font-size: 28rpx;
    color: #9F6B65;
    padding: 15rpx 20rpx;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    box-sizing: border-box;
}

/* 生成路线按钮 */
.plan-btn {
    background: linear-gradient(135deg, #9F6B65 0%, #8B5A50 100%);
    color: white;
    border-radius: 20rpx;
    padding: 20rpx;
    font-size: 32rpx;
    font-weight: bold;
    margin-top: 10rpx;
    border: none;
    height: 80rpx;
    line-height: 50rpx;
    box-sizing: border-box;
    box-shadow: 0 4rpx 16rpx rgba(159, 107, 101, 0.3);
}

.plan-btn.disabled {
    background: #ccc;
}

/* 路线展示区  */
.route-panel {
    width: 100%;
    background: transparent !important;
    padding: 0;
    border-radius: 0;
    box-sizing: border-box;
    margin-bottom: 0;
    box-shadow: none;
    border: none;
}

.loading-tip {
    width: 100%;
    text-align: center;
    padding: 40rpx;
    color: #9F6B65;
    font-size: 28rpx;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 24rpx;
    margin-bottom: 20rpx;
    box-sizing: border-box;
}

/* 无数据提示  */
.empty-tip {
    width: 100%;
    text-align: center;
    padding: 60rpx;
    color: #9F6B65;
    font-size: 28rpx;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 24rpx;
    box-sizing: border-box;
}

/* 第X站标题 */
.station-title {
    font-size: 32rpx;
    color: #333;
    font-weight: bold;
    margin-top: 30rpx;
    margin-bottom: 15rpx;
}

/* 信息卡片 */
.info-card {
    width: 100%;
    background: rgba(255,255,255,0.75) !important;
    border-radius: 20rpx;
    padding: 25rpx;
    margin-bottom: 20rpx;
    border: 1px solid #e5e5e5;
    box-sizing: border-box;
}

/* 信息项 */
.info-item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 15rpx;
    width: 100%;
    box-sizing: border-box;
}

.info-label {
    font-size: 26rpx;
    color: #666;
    width: 140rpx;
}

.info-value {
    font-size: 26rpx;
    color: #333;
    flex: 1;
}

.info-image {
    width: 100%;
    height: 300rpx;
    border-radius: 12rpx;
    margin-top: 10rpx;
    box-sizing: border-box;
}

.container { padding: 24rpx; }
.main-card { background: rgba(255,255,255,.78); border-color: rgba(159,107,101,.14); padding: 30rpx; }
.select-item { justify-content: flex-start; min-height: 88rpx; margin-bottom: 16rpx; border-bottom: 1rpx solid rgba(159,107,101,.12); }
.select-item:last-of-type { border-bottom: 0; }
.picker-text { min-height: 64rpx; line-height: 64rpx; border-radius: 14rpx; background: rgba(255,249,230,.85); }
.plan-btn { width: 100%; min-height: 88rpx; line-height: 88rpx; padding: 0; border-radius: 16rpx; }
.info-card { background: rgba(255,255,255,.88) !important; border: 1rpx solid rgba(159,107,101,.14); box-shadow: 0 6rpx 18rpx rgba(159,107,101,.08); }
.info-card:active { opacity: .82; transform: scale(.99); }
.station-title { color: #9F6B65; padding-left: 12rpx; }
