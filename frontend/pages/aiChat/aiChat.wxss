page {
    height: 100%;
    background: linear-gradient(135deg, #FFFBEE 0%, #FFF3D8 100%);
}

.chat-container {
    display: flex;
    flex-direction: column;
    height: 100vh;
    box-sizing: border-box;
}

.msg-list {
    flex: 1;
    min-height: 0;
    padding: 24rpx 24rpx 0;
    box-sizing: border-box;
}

.msg-row {
    display: flex;
    align-items: flex-start;
    margin-bottom: 28rpx;
}

.msg-row.user {
    flex-direction: row-reverse;
}

.avatar {
    width: 64rpx;
    height: 64rpx;
    border-radius: 50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24rpx;
    font-weight: bold;
}

.avatar.assistant {
    background: linear-gradient(135deg, #9F6B65 0%, #8B5A50 100%);
    color: #fff;
    margin-right: 16rpx;
}

.avatar.user {
    background: rgba(255, 255, 255, 0.95);
    color: #9F6B65;
    border: 1rpx solid rgba(159, 107, 101, 0.3);
    margin-left: 16rpx;
}

.bubble {
    max-width: 74%;
    padding: 20rpx 26rpx;
    border-radius: 20rpx;
    font-size: 28rpx;
    line-height: 1.6;
    word-break: break-word;
    white-space: pre-wrap;
}

.msg-row.assistant .bubble {
    background: #fff;
    color: #333;
    border-top-left-radius: 6rpx;
    box-shadow: 0 4rpx 16rpx rgba(159, 107, 101, 0.12);
}

.msg-row.user .bubble {
    background: linear-gradient(135deg, #9F6B65 0%, #8B5A50 100%);
    color: #fff;
    border-top-right-radius: 6rpx;
    box-shadow: 0 4rpx 16rpx rgba(159, 107, 101, 0.3);
}

.thinking {
    color: #B98B85;
    font-style: italic;
}

.quick-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
    padding: 16rpx 24rpx 8rpx;
    box-sizing: border-box;
}

.quick-chip {
    font-size: 24rpx;
    color: #9F6B65;
    background: rgba(255, 255, 255, 0.85);
    border: 1rpx solid rgba(159, 107, 101, 0.35);
    padding: 12rpx 22rpx;
    border-radius: 999rpx;
}

.quick-chip:active {
    opacity: 0.75;
}

.input-bar {
    display: flex;
    align-items: center;
    padding: 16rpx 24rpx;
    padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
    padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.94);
    border-top: 1rpx solid rgba(159, 107, 101, 0.14);
    box-sizing: border-box;
}

.chat-input {
    flex: 1 1 0%;
    min-width: 0;
    width: auto;
    height: 76rpx;
    line-height: 76rpx;
    background: #F5F1E8;
    border-radius: 38rpx;
    padding: 0 30rpx;
    font-size: 28rpx;
    color: #333;
    box-sizing: border-box;
}

.input-placeholder {
    color: #B98B85;
}

.send-btn {
    width: 76rpx !important;
    min-width: 0 !important;
    max-width: 76rpx !important;
    flex: 0 0 auto !important;
    height: 76rpx !important;
    line-height: 76rpx !important;
    padding: 0 !important;
    margin: 0 0 0 16rpx !important;
    font-size: 22rpx !important;
    border-radius: 50% !important;
    background: linear-gradient(135deg, #9F6B65 0%, #8B5A50 100%);
    color: #fff;
    border: none;
    box-sizing: border-box;
}

.send-btn::after {
    border: none;
}

.send-btn[disabled] {
    opacity: 0.5;
    color: #fff;
}
