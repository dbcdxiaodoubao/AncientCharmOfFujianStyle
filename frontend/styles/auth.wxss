.login-container, .register-container { padding:0 36rpx 64rpx; min-height:100vh; box-sizing:border-box; }
.auth-hero { position:relative; overflow:hidden; height:340rpx; margin:0 -8rpx; display:flex; align-items:center; padding:30rpx 8rpx 0; box-sizing:border-box; }
.auth-hero .hero-art { right:-36rpx; top:-40rpx; opacity:.75; }
.auth-heading { position:relative; z-index:1; }
.title { font-size:64rpx; font-family:'Songti SC','STSong','SimSun',serif; font-weight:700; color:#383c30; letter-spacing:6rpx; }
.subtitle { font-size:25rpx; margin-top:14rpx; letter-spacing:4rpx; color:#6b6356; }
.auth-panel { padding:36rpx 28rpx; }
.auth-panel-title { display:block; margin-bottom:28rpx; font-family:'Songti SC','STSong',serif; font-size:36rpx; font-weight:600; }
.input-item { display:flex; align-items:center; gap:12rpx; min-height:96rpx; padding:12rpx 22rpx; margin-bottom:22rpx; background:#f6f3ec; border:1rpx solid #fff; border-radius:20rpx; box-shadow:inset 3rpx 3rpx 9rpx rgba(139,125,107,.1),inset -3rpx -3rpx 9rpx #fff; box-sizing:border-box; }
.input-label { flex-shrink:0; width:142rpx; color:#625e53; font-size:26rpx; }
.input-content { flex:1; min-width:0; width:auto; height:64rpx; font-size:27rpx; color:#383c30; }
.login-btn, .register-btn, .back-btn { width:100%; min-height:90rpx; line-height:90rpx; padding:0; margin:20rpx 0 0; border-radius:20rpx; font-size:30rpx; }
.login-btn, .register-container .register-btn { color:#fff; background:linear-gradient(120deg,#6b774a,#536035); box-shadow:0 6rpx 18rpx rgba(89,102,56,.15); }
.login-container .register-btn, .back-btn { background:#f2efe7; color:#596638; border:1rpx solid rgba(139,125,107,.22); }
